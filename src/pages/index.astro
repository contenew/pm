---
import Layout from '../layouts/Layout.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import '../styles/animations.css';

// データを静的に定義して再利用
const services = [
    {
        title: "グロースハック",
        icon: "📈",
        description: "データ分析とユーザー行動の深い理解に基づき、持続可能な成長を実現します。",
        features: ["ユーザー獲得戦略", "リテンション最適化", "バイラルループ設計"]
    },
    {
        title: "プロダクト戦略",
        icon: "🎯",
        description: "市場とユーザーニーズを的確に捉え、競争優位性のある製品戦略を策定します。",
        features: ["市場分析", "製品ロードマップ", "収益化モデル"]
    },
    {
        title: "PMコンサルティング",
        icon: "⚡️",
        description: "組織全体のプロダクト開発プロセスを最適化し、イノベーションを加速します。",
        features: ["チーム構築", "プロセス改善", "スキル開発"]
    }
];

const caseStudies = [
    {
        title: "SaaS スタートアップの急成長",
        metrics: "MAU 50倍増加",
        description: "プロダクトマーケットフィットの再定義とグロース戦略の実装により、6ヶ月で驚異的な成長を達成。",
        results: ["ユーザー獲得コスト70%削減", "継続率2倍向上", "収益10倍増"]
    },
    {
        title: "大手企業のDX推進",
        metrics: "開発速度75%向上",
        description: "レガシーシステムのモダナイゼーションとアジャイル開発の導入により、製品開発プロセスを革新。",
        results: ["リリースサイクル短縮", "チーム生産性向上", "顧客満足度90%達成"]
    }
];
---

<Layout title="Product Management Consultant">
	<main>
		<section class="relative min-h-screen overflow-hidden bg-gray-950">
			<ParticleBackground />
			<div class="absolute inset-0 bg-gradient-to-b from-transparent via-gray-950/50 to-gray-950 pointer-events-none"></div>
			
			<div class="container mx-auto px-4 py-20 relative z-10 flex flex-col items-center justify-center min-h-screen">
				<div class="text-center max-w-4xl">
					<div class="mb-8 relative">
						<span class="inline-block px-4 py-2 rounded-full text-sm font-medium bg-white/5 text-white backdrop-blur-sm mb-4">
							Product Management Excellence
						</span>
					</div>
					<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white leading-tight">
						Innovate Your
						<span class="text-white/90">
							Product Vision
						</span>
					</h1>
					<p class="text-xl md:text-2xl text-gray-400 mb-12 leading-relaxed">
						データドリブンな意思決定と革新的な戦略で、
						<br class="hidden md:block" />
						あなたのプロダクトを次のレベルへ導きます
					</p>

					<div class="flex flex-col md:flex-row gap-6 justify-center">
						<a href="#contact" 
							class="group relative px-8 py-4 rounded-full bg-white/10 backdrop-blur-sm text-white font-medium hover:bg-white/15 transform hover:-translate-y-1 transition-all duration-200">
							<span class="relative">無料相談を予約する</span>
						</a>
						<a href="#services" 
							class="group relative px-8 py-4 rounded-full glass-effect text-white/80 font-medium border border-white/5 hover:bg-white/10 transition-all duration-200">
							<span class="relative">サービスを見る</span>
						</a>
					</div>
				</div>

				<div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 flex items-center gap-2">
					<span class="w-1 h-1 rounded-full bg-white/50"></span>
					<span class="w-1 h-1 rounded-full bg-white/50"></span>
					<span class="w-1 h-1 rounded-full bg-white"></span>
					<span class="w-1 h-1 rounded-full bg-white/50"></span>
					<span class="w-1 h-1 rounded-full bg-white/50"></span>
				</div>
			</div>
		</section>

		<!-- Services Section -->
		<section id="services" class="py-20 bg-gray-900">
			<div class="container mx-auto px-4">
				<h2 class="text-4xl font-bold text-center mb-16 text-white">
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-green-400 to-blue-500">
						Expert Services
					</span>
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
					{services.map(service => (
						<div class="glass-effect rounded-2xl p-8 text-white hover:glow transform hover:-translate-y-2 transition-all duration-300">
							<div class="text-4xl mb-4">{service.icon}</div>
							<h3 class="text-xl font-bold mb-4">{service.title}</h3>
							<p class="text-gray-300 mb-6">{service.description}</p>
							<ul class="space-y-2">
								{service.features.map(feature => (
									<li class="flex items-center">
										<span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
										{feature}
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Case Studies Section -->
		<section id="case-studies" class="py-20 bg-gray-800">
			<div class="container mx-auto px-4">
				<h2 class="text-4xl font-bold text-center mb-16 text-white">
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-green-400 to-blue-500">
						Success Stories
					</span>
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
					{caseStudies.map(case_study => (
						<div class="glass-effect rounded-2xl p-8 text-white hover:glow transform hover:-translate-y-2 transition-all duration-300">
							<h3 class="text-2xl font-bold mb-2">{case_study.title}</h3>
							<div class="text-green-400 font-bold text-xl mb-4">{case_study.metrics}</div>
							<p class="text-gray-300 mb-6">{case_study.description}</p>
							<ul class="space-y-2">
								{case_study.results.map(result => (
									<li class="flex items-center">
										<span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
										{result}
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section id="contact" class="py-20 bg-gray-900">
			<div class="container mx-auto px-4">
				<h2 class="text-4xl font-bold text-center mb-16 text-white">
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-green-400 to-blue-500">
						Let's Connect
					</span>
				</h2>
				<div class="max-w-xl mx-auto">
					<form class="glass-effect rounded-2xl p-8 text-white">
						<div class="space-y-6">
							<div>
								<label class="block text-sm font-medium mb-2">お名前</label>
								<input type="text" class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-700 text-white focus:ring-2 focus:ring-green-400 focus:border-transparent">
							</div>
							<div>
								<label class="block text-sm font-medium mb-2">会社名</label>
								<input type="text" class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-700 text-white focus:ring-2 focus:ring-green-400 focus:border-transparent">
							</div>
							<div>
								<label class="block text-sm font-medium mb-2">メールアドレス</label>
								<input type="email" class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-700 text-white focus:ring-2 focus:ring-green-400 focus:border-transparent">
							</div>
							<div>
								<label class="block text-sm font-medium mb-2">ご相談内容</label>
								<textarea rows="4" class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-700 text-white focus:ring-2 focus:ring-green-400 focus:border-transparent"></textarea>
							</div>
							<button type="submit" class="w-full py-4 rounded-full bg-gradient-to-r from-green-400 to-blue-500 text-white font-medium hover:shadow-lg transform hover:-translate-y-1 transition-all duration-200">
								無料相談を予約する
							</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* 最適化されたアニメーション */
	.hover\:glow:hover {
		box-shadow: 0 0 15px rgba(74, 222, 128, 0.2);
	}

	.glass-effect {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	/* フォーム要素のスムーズな遷移 */
	input, textarea, button {
		transition: all 0.2s ease-in-out;
		will-change: transform, opacity;
	}

	/* 画像の遅延読み込み */
	img {
		loading: lazy;
	}
</style>
